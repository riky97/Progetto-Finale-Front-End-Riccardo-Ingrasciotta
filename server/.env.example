# Copy to server/.env and fill in. server/.env is gitignored — never commit real keys.
#
#   cp server/.env.example server/.env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches the postgres service in the repo-root docker-compose.yml locally.
# In production this is the Supabase project's connection string (Supabase
# dashboard → Project Settings → Database → Connection string → URI). Use the
# pooled "Transaction" connection string (port 6543), not the direct one —
# Render's free plan can open more connections than Supabase's direct port
# allows.
DATABASE_URL="postgresql://anime:animedev@localhost:5432/animelist?schema=public"

# ---------------------------------------------------------------------------
# Clerk
# ---------------------------------------------------------------------------
# Backend API key from https://dashboard.clerk.com → API keys → Secret keys.
# Required: the auth middleware refuses to start without it.
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Publishable key — NOT secret, but the backend genuinely requires it:
# @clerk/express derives the Frontend API origin from it and throws
# "Publishable key is missing" on every request without it. The frontend needs
# the same value as VITE_CLERK_PUBLISHABLE_KEY in the root .env.
CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OPTIONAL — networkless JWT verification. Paste the PEM public key from
# Clerk dashboard → API keys → Show JWT public key → PEM. When set, session
# tokens are verified locally against this key instead of fetching Clerk's JWKS
# on every cold start. It is also the hook the local test harness
# (scripts/dev-token.ts + scripts/auth-smoke.ts) uses to exercise verification
# without live Clerk keys — see server/README.md.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Render injects PORT itself; 8080 is only the local default.
PORT=8080

# Comma-separated list of allowed browser origins, in addition to the always
# allowed Vite dev server at http://localhost:3000.
# e.g. CORS_ORIGIN="https://anime-list.example.com,https://www.anime-list.example.com"
CORS_ORIGIN=""
