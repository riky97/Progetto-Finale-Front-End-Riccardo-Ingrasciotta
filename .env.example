# Copy to .env.local (gitignored) and fill in.
#
#   cp .env.example .env.local

# Clerk publishable key, from https://dashboard.clerk.com → API keys.
# Not a secret — it ships in the browser bundle — but the app refuses to boot
# without it, since every route sits inside <ClerkProvider>.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Origin of the favorites/watched backend in server/. Defaults to
# http://localhost:8080 when unset.
VITE_API_URL=http://localhost:8080

# Optional: point the AniList client at a proxy or fixture server.
# VITE_ANILIST_URL=https://graphql.anilist.co
